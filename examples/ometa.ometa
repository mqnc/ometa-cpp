

#include "ometa.h"

#include <cassert>
#include <iostream>
#include <fstream>
#include <cmath>
#include <string>
#include <ctime>

using ViewTree = ometa::ViewTree<std::string_view>;

int main(int argc, char* argv[]) {

	char* inputPath;
	char* outputPath;

	if(argc == 3 || argc == 4){
		inputPath = argv[1];
		outputPath = argv[2];
		if(argc == 4){
			std::string v = argv[3];
			if(v=="-v"){ometa::globalDebugLevel = 1;}
			else if(v=="-vv"){ometa::globalDebugLevel = 2;}
			else if(v=="-vvv"){ometa::globalDebugLevel = 3;}
			else{
				std::cout << "unknown verbosity setting: " << v << "; expected -v, -vv or -vvv\n";
				return EXIT_FAILURE;
			}
		}
	}
	else{
		std::cout << "usage: " << argv[0] << " INPUT_FILE OUTPUT_FILE [-v[v[v]]]\n";
		return EXIT_FAILURE;
	}

	comment := "/*" (!"*/" .)* "*/"
		| "//" (!"\n" .)* "\n";

	_ := (" " | "\t" | "\n" | comment)*;

	identStart := {'A'}..{'Z'} | {'a'}..{'z'} | "_" | "::";
	identContinue := identStart | {'0'}..{'9'};
	identifier := <identStart identContinue*>;

	cppChar := "\\" . | .;
	cppLiteral := <
		"'" (!"'" cppChar)* "'"
		| "\"" (!"\"" cppChar)* "\""
	>;
	
	viewTreeLiteral := "`" {`\"`}<(!"`" cppChar)*> "`" {`\"_tree_`} => ometa::concat;

	valueReference := "$" => {`value`};
	indexedValueReference := "$" <{'0'}..{'9'}+> => {`ometa::pick<` + $ + `>(value)`};
	taggedValueReference := "$" identifier => {`ometa::pick<\"` + $ + `\">(value)`};

	%cppExpression : {std::string_view} -> {ViewTree};
	cppExpressionWithParens := "(" cppExpression ")" => {`(` + $ + `)`};
	cppExpressionWithBrackets := "[" cppExpression "]" => {`[` + $ + `]`};
	cppExpressionBetweenBraces := "{" cppExpression "}";
	cppExpressionWithBraces := cppExpressionBetweenBraces => {`{` + $ + `}`};
	predicatecppExpression := "{" _ "?" cppExpression "}";

	contextReference := "@" identifier => {`context.` + $};

	%cppExpression := (
		identifier => {? $ != "return"}
		| contextReference
		| viewTreeLiteral
		| cppLiteral
		| cppExpressionWithParens
		| cppExpressionWithBrackets
		| cppExpressionWithBraces
		| indexedValueReference
		| taggedValueReference
		| valueReference
		| !")" !"]" !"}" !";" <.>
	)* => ometa::concat;

	%cppCode : {std::string_view} -> {ViewTree};
	cppCodeWithParens := "(" cppCode ")" => {`(` + $ + `)`};
	cppCodeWithBrackets := "[" cppCode "]" => {`[` + $ + `]`};
	cppCodeBetweenBraces := "{" cppCode "}";
	cppCodeWithBraces := cppCodeBetweenBraces => {`{` + $ + `}`};
	predicateCppCode := "{" _ "?" cppCode "}";

	%ruleForwardDecl : {std::string_view} -> {ViewTree};
	%ruleDefinition : {std::string_view} -> {ViewTree};
	%ruleAssignment : {std::string_view} -> {ViewTree};
	%macroDefinition : {std::string_view} -> {ViewTree};

	%cppCode := (
		ruleForwardDecl
		| ruleDefinition
		| ruleAssignment
		| macroDefinition
		| contextReference
		| identifier
		| viewTreeLiteral
		| cppLiteral
		| cppCodeWithParens
		| cppCodeWithBrackets
		| cppCodeWithBraces
		| indexedValueReference
		| taggedValueReference
		| valueReference
		| !")" !"]" !"}" <.>
	)* => ometa::concat;

	any := "." => {`ometa::any()`};
	epsilon := "(" _ ")" => {`ometa::epsilon()`};

	literalCharacter :=
		<"\\" ("n" | "r" | "t" | "'" | "\"" | "\\")>
		| "\"" => {`\\\"`}
		| <!"\\" .>;

	literal := cppLiteral {`_lit_`} => ometa::concat;

	range := cppCodeBetweenBraces _ ".." _ cppCodeBetweenBraces => {
		`ometa::range((` + $0 + `), (` + $1 + `))`
	};

	%expression : {std::string_view} -> {ViewTree};
	expressionWithParens := "(" _ expression _ ")" => {`(` + $ + `)`};
	capture := "<" _ expression _ ">" => {`ometa::capture(` + $ + `)`};

	action :=
		identifier
		| cppExpressionBetweenBraces => {`ometa::action([](auto value, auto& context){return ` + $ + `;})`}
		| cppCodeBetweenBraces => {`ometa::action([](auto value, auto& context){` + $ + `})`};
	predicate :=
		identifier
		| predicatecppExpression => {`ometa::predicate([](auto value, auto& context){return ` + $ + `;})`}
		| predicateCppCode => {`ometa::predicate([](auto value, auto& context){` + $ + `})`};

	parametricPredicateOrAction := "=>" {` >= `} _ (predicate | action) => ometa::concat;

	macroCall := identifier _ "[" {`(`} _
		expression _ (<","> {` `} _ expression)*
		_ "]" {`)`} => ometa::concat;

	primary :=
		macroCall
		| any
		| epsilon
		| literal
		| range
		| capture
		| predicate
		| action
		| expressionWithParens;

	optional := "?" => {`-`};
	zeroOrMore := "*" => {`*`};
	oneOrMore := "+" => {`+`};
	repetition := optional | zeroOrMore | oneOrMore;
	tag := ":" _ identifier;

	digit := {'0'}..{'9'};
	debugMark := <digit digit? digit?>;

	debugMarkedParser := (debugMark _)? primary
		=> {
			if ($0.size() == 0){return $1;}
			else {return `ometa::logger(\"` + $0[0] + `\", ` + $1 + `)`;}
		};

	postfixed := debugMarkedParser _ tag? _ repetition? _ tag?
		=> { 
			auto result = $0;
			if ($1.size() == 1) {result = `ometa::tagResult<\"` + $1[0] + `\">(` + result + `)`;}
			if ($2.size() == 1) {result = $2[0] + result;}
			if ($3.size() == 1) {result = `ometa::tagResult<\"` + $3[0] + `\">(` + result + `)`;}
			return result;
		};

	prefixed := <("&" | "!" | "~")?> _ postfixed => ometa::concat;

	sequence := prefixed ( _ (
			{` > `} prefixed => ometa::concat
			| parametricPredicateOrAction
	))* => ometa::concat;

	choice := sequence (
		<_ "|" _> sequence
	)* => ometa::concat;

	%expression := choice;

	%ruleForwardDecl := "%" _ identifier _ ":" _
		cppExpressionBetweenBraces _ "->" _ cppExpressionBetweenBraces _ ";"
		=> {
			`DECL_DEBUG_TAG(RULE_` + $0 + `, \"` + $0 + `\", true); auto ` + $0 + ` = ometa::recursive<`
				+ $1 + `, ` + $2 + `>();`
		};

	%ruleDefinition := (debugMark _)? identifier _ ":=" _ expression _ ";"
		=> {
			auto assignee = `DECL_DEBUG_TAG(RULE_` + $1 + `, \"` + $1 + `\", true); const auto ` + $1;
			auto body = `ometa::rule<RULE_` + $1 + `>(` + $2 + `)`;
			if ($0.size() == 0){ return assignee + ` = ` + body + `;`; }
			else { return assignee + ` = ometa::logger(\"` + $0[0] + `\", ` + body + `);`; }
		};

	%ruleAssignment := (debugMark _)? "%" _ identifier _ ":=" _ expression _ ";"
		=> {
			auto body = `ometa::rule<RULE_` + $1 + `>(` + $2 + `)`;
			if ($0.size() == 0){ return $1 + `.define(` + body + `);`; }
			else{ return $1 + `.define(ometa::logger(\"` + $0[0] + `\", ` + body + `));`; }
		};

	macroParameterList := "[" _ {`auto `} identifier _
		("," _ identifier => {`, auto ` + $})* _ "]"
		=> ometa::concat;
	%macroDefinition := identifier _ macroParameterList _ ":=" _ expression _ ";"
		=> {
			`const auto ` + $0 + ` = [=](` + $1 + `){return ` + $2 + `;};`
		};

	auto code = ometa::readFile(inputPath);

	auto result = cppCode.parse(code);
	if (result) {
		ometa::writeFile(outputPath, *result);
	}
	else {
		std::cout << "fail\n";
		return EXIT_FAILURE;
	}

	return EXIT_SUCCESS;
}
